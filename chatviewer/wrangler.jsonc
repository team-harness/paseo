{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paseo-chat-viewer",
  "main": "worker.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "r2_buckets": [
    {
      "binding": "CHAT_SHARES",
      "bucket_name": "paseo-chat-shares",
    },
  ],
}
